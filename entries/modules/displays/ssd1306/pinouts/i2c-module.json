    {
      "id": "4",
      "name": "SDA",
      "type": "bus",
      "direction": "bidirectional",
      "drive": "open-drain",
      "level": "3.3 V logic",
      "voltage": {
        "max": 3.3
      },
      "notes": [
        {
          "severity": "danger",
          "text": "A 5 V-capable module supply does not guarantee 5 V-tolerant signal pins; verify level shifting on the specific board."
        }
      ]
