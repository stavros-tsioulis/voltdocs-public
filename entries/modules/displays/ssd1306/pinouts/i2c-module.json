{
  "$schema": "https://voltdocs.dev/schemas/pinout-1.json",
  "version": 1,
  "pins": [
    {
      "id": "1",
      "name": "GND",
      "type": "ground",
      "description": "Ground reference."
    },
    {
      "id": "2",
      "name": "VCC",
      "type": "power",
      "direction": "power-in",
      "voltage": {
        "min": 3.3,
        "nominal": 3.3,
        "max": 5.0
      }
    },
    {
      "id": "3",
      "name": "SCL / SCK",
