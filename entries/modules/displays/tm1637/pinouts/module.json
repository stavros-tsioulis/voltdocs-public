    {
      "id": "3",
      "name": "VCC",
      "type": "power",
      "direction": "power-in",
      "voltage": {
        "min": 3.3,
        "nominal": 5.0,
        "max": 5.5
      }
    },
    {
      "id": "4",
      "name": "GND",
      "type": "ground",
      "description": "Ground reference."
    }
  ],
  "layout": {
    "package": "module",
    "sides": {
      "bottom": [
        "1",
        "2",
        "3",
        "4"
      ]
    },
    "label": "TM1637",
    "minSize": {
      "width": 8,
      "height": 5
    }
  }
