{
  "$schema": "https://voltdocs.dev/schemas/pinout-1.json",
  "version": 1,
  "pins": [
    {
      "id": "1",
      "name": "CLK",
      "type": "clock",
      "direction": "input",
      "description": "Serial clock input."
    },
    {
      "id": "2",
      "name": "DIO",
      "type": "bus",
      "direction": "bidirectional",
      "drive": "open-drain",
      "description": "Bidirectional serial data.",
      "notes": [
        {
          "severity": "warning",
