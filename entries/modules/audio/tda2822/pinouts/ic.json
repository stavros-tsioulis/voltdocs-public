{
  "$schema": "../../../../schemas/pinout.ic.schema.json",
  "title": "TDA2822M DIP-8 / SOIC-8 Pinout",
  "package": "DIP-8",
  "pins": [
    { "number": 1, "name": "OUT1", "type": "output", "description": "Channel 1 amplifier output" },
    { "number": 2, "name": "VCC", "type": "power", "description": "Positive supply voltage (+1.8V to +15.0V)" },
    { "number": 3, "name": "OUT2", "type": "output", "description": "Channel 2 amplifier output" },
    { "number": 4, "name": "GND", "type": "ground", "description": "Ground reference (0V)" },
    { "number": 5, "name": "-IN2", "type": "input", "description": "Channel 2 inverting input" },
    { "number": 6, "name": "+IN2", "type": "input", "description": "Channel 2 non-inverting input" },
    { "number": 7, "name": "+IN1", "type": "input", "description": "Channel 1 non-inverting input" },
    { "number": 8, "name": "-IN1", "type": "input", "description": "Channel 1 inverting input" }
  ]
}
