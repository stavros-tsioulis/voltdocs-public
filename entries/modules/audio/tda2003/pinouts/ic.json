{
  "$schema": "https://voltdocs.dev/schemas/pinout-1.json",
  "version": 1,
  "pins": [
    {
      "id": "1",
      "name": "IN+",
      "type": "analog",
      "direction": "input",
      "description": "Pin IN+"
    },
    {
      "id": "2",
      "name": "IN-",
      "type": "analog",
      "direction": "input",
      "description": "Pin IN-"
    },
    {
      "id": "3",
      "name": "GND",
      "type": "power",
      "direction": "power-in",
      "description": "Pin GND"
    },
    {
      "id": "4",
      "name": "OUT",
      "type": "digital",
      "direction": [
        "analog",
        "output"
      ],
      "description": "Pin OUT"
    },
    {
      "id": "5",
      "name": "VS",
      "type": "power",
      "direction": "power-in",
      "description": "Pin VS"
    }
  ],
  "layout": {
    "package": "ic",
    "sides": {
      "bottom": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    }
  }
}