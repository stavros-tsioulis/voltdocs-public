{
  "$schema": "https://voltdocs.dev/schemas/pinout-1.json",
  "version": 1,
  "pins": [
    {
      "id": "1",
      "name": "VCC",
      "type": "power",
      "direction": "power-in",
      "voltage": {
        "min": 4.5,
        "nominal": 5.0,
        "max": 5.5
      },
      "description": "Supply voltage input (+5.0 V DC)."
    },
    {
      "id": "2",
      "name": "OUT / OUT1",
      "type": "analog",
      "direction": "output",
      "description": "Analog AC output voltage centered at 2.5 V DC offset."
    },
    {
      "id": "3",
      "name": "NC / OUT2",
      "type": "nc",
      "direction": "passive",
      "description": "Unconnected or duplicate ground pin."
    },
    {
      "id": "4",
      "name": "GND",
      "type": "ground",
      "direction": "passive",
      "description": "System ground reference (0 V)."
    }
  ],
  "layout": {
    "package": "module",
    "sides": {
      "bottom": [
        "1",
        "2",
        "3",
        "4"
      ]
    },
    "label": "ZMPT101B",
    "minSize": {
      "width": 6,
      "height": 4
    }
  },
  "wiring": [
    {
      "id": "arduino-uno",
      "label": "Arduino Uno",
      "targetId": "board.arduino.uno",
      "pins": {
        "1": "5V",
        "2": "A0",
        "4": "GND"
      }
    }
  ]
}
