{
  "$schema": "https://voltdocs.dev/schemas/pinout-1.json",
  "version": 1,
  "pins": [
    {
      "id": "S",
      "name": "SIGNAL",
      "type": "digital",
      "direction": "output",
      "description": "Active-low IR output."
    },
    {
      "id": "+",
      "name": "VCC",
      "type": "power",
      "direction": "power-in",
      "voltage": {
        "min": 2.7,
        "nominal": 5.0,
        "max": 5.5
      }
    },
    {
      "id": "−",
      "name": "GND",
      "type": "ground",
      "description": "Ground reference."
    }
  ],
  "layout": {
    "package": "module",
    "sides": {
      "bottom": [
        "S",
        "+",
        "−"
      ]
    },
    "label": "IR receiver",
    "minSize": {
      "width": 5,
      "height": 5
    }
  }
}
