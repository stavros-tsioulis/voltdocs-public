{
  "$schema": "https://voltdocs.dev/schemas/pinout-1.json",
  "version": 1,
  "pins": [
    {
      "id": "1",
      "name": "VIN",
      "type": "power",
      "direction": "power-in",
      "voltage": {
        "min": 3.3,
        "nominal": 5.0,
        "max": 5.0
      },
      "description": "Supply voltage input (+3.3 V to +5.0 V DC)."
    },
    {
      "id": "2",
      "name": "GND",
      "type": "ground",
      "direction": "passive",
      "description": "Ground reference (0 V)."
    },
    {
      "id": "3",
      "name": "SCL",
      "type": "clock",
      "direction": "input",
      "level": "3.3 V logic",
      "description": "I2C serial clock line."
    },
    {
      "id": "4",
      "name": "SDA",
      "type": "bus",
      "direction": "bidirectional",
      "level": "3.3 V logic",
      "description": "I2C serial data line."
    },
    {
      "id": "5",
      "name": "INT",
      "type": "digital",
      "direction": "output",
      "drive": "open-drain",
      "level": "3.3 V logic",
      "description": "Active-LOW interrupt output."
    },
    {
      "id": "6",
      "name": "IRD",
      "type": "power",
      "direction": "power-out",
      "description": "Infrared LED cathode connection (internal connection on 5-pin boards)."
    },
    {
      "id": "7",
      "name": "RD",
      "type": "power",
      "direction": "power-out",
      "description": "Red LED cathode connection (internal connection on 5-pin boards)."
    }
  ],
  "layout": {
    "package": "module",
    "sides": {
      "bottom": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7"
      ]
    },
    "label": "MAX30102",
    "minSize": {
      "width": 9,
      "height": 5
    }
  },
  "wiring": [
    {
      "id": "arduino-uno",
      "label": "Arduino Uno",
      "targetId": "board.arduino.uno",
      "pins": {
        "1": "3.3V",
        "2": "GND",
        "3": "SCL",
        "4": "SDA",
        "5": "D2"
      }
    }
  ]
}
