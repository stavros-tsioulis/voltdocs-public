{
  "$schema": "../../../../schemas/pinout.ic.schema.json",
  "title": "L9110S SOP-8 Pinout",
  "package": "SOP-8",
  "pins": [
    { "number": 1, "name": "OA", "type": "output", "description": "Output terminal A (motor lead 1)" },
